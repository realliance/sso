# Managed by realliance/sso (host/roles/keycloak). Build options (db, health, metrics,
# features) take effect through `kc.sh build`, which the role's handler runs on change.
db=postgres
db-url=jdbc:postgresql://127.0.0.1:5432/keycloak
db-username=keycloak
db-pool-max-size={{ keycloak_db_pool_max }}
hostname=https://{{ sso_hostname }}
http-enabled=true
http-host=127.0.0.1
http-port=8080
proxy-headers=xforwarded
health-enabled=true
metrics-enabled=true
{% if keycloak_features | length > 0 %}
features={{ keycloak_features | join(',') }}
{% endif %}
