# Managed by realliance/sso (host/roles/keycloak). Secrets come from /etc/realliance-sso/secrets.yml.
KC_DB_PASSWORD={{ postgres_keycloak_password }}
JAVA_OPTS_KC_HEAP={{ keycloak_heap_opts }}
# Bind plain IPv4 loopback (127.0.0.1), not the IPv4-mapped IPv6 socket Java picks by default.
JAVA_OPTS_APPEND=-Djava.net.preferIPv4Stack=true
{% if keycloak_bootstrap_admin %}
KC_BOOTSTRAP_ADMIN_USERNAME=temp-admin
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_bootstrap_admin_password }}
{% endif %}
