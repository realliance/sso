# Managed by realliance/sso (host/roles/backup). Scoped B2 key: no deleteFiles; bucket is object-locked.
RCLONE_CONFIG_B2_TYPE=s3
RCLONE_CONFIG_B2_PROVIDER=Other
RCLONE_CONFIG_B2_ENDPOINT={{ b2_s3_endpoint }}
RCLONE_CONFIG_B2_REGION={{ b2_region }}
RCLONE_CONFIG_B2_NO_CHECK_BUCKET=true
RCLONE_CONFIG_B2_ACCESS_KEY_ID={{ b2_backup_key_id }}
RCLONE_CONFIG_B2_SECRET_ACCESS_KEY={{ b2_backup_application_key }}
